  <script>
    (function () {
      window.addEventListener('app-ready', function() {
        var loadingStatus = false;
        var $el = $('#widget_1220916374');
        var $carousel = $el.find('[data-carousel]');
        var carousel = $el.magCarousel({
          carousel: '[data-carousel]',
          carouselOptions: {
            loop: true,
            responsive: {
              0: {
                items: 2
              },
              600: {
                items: 3
              },
              1000: {
                items: 4
              },
              1200: {
                items: 5
              }
            },
                        onTranslated: function (event) {
              var items = event.item.count;
              var pages = event.page.count;
              var page = event.page.index;
              if (pages > 1) {
                if (pages - page < 2 && !loadingStatus) {
                  loadingStatus = true;
                  $.ajax({
                    'url': '/api/related/c5fLPx',
                    'data': {
                      'skip': items + 10
                    }
                  })
                    .then(function (res) {
                      var template = $('#gifCarouselItemTemplate').html();
                      Mustache.parse(template);
                      res.forEach(function (item) {
                        $carousel.owlCarousel('add', $(Mustache.render(template, {gif: item})).html());
                      });
                      $carousel.owlCarousel('refresh');

                      return res;
                    })
                    .always(function () {
                      loadingStatus = false;
                    });
                }
              }
            }
                      }
        });
      });
    })();
  </script>
