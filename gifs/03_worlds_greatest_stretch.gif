<script>
  window.addEventListener('app-ready', function() {
    $(document).on('click', '[data-action="selcopy"]', function () {
      var el = $(this);
      var res = el.parent().find('.js--result');
      var act = function (e, text) {
        e.html(text).fadeIn(300).promise().done(function(){
          e.fadeOut(300).html();
        });
      }
      res.css({'margin-left':'8px','display':'none'});
      el.select();
      try {
        var successful = document.execCommand('copy');

        if (successful) {
          act(res, 'Copied!');
        }
        else {
          act(res, 'Unable to copy!');
        }
      } catch (err) {
        act(res, 'Unsupported Browser!');
      }
    });
  });
</script>

