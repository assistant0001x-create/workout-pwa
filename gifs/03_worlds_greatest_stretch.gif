    loop="loop"
    muted
    autoplay
    playsinline
    width="100%"
    height="100%"
    onerror="applyDummyPlaceholder(this)"
  >
    <p>HTML5-compatible browser is required to view this video</p>
  </video>

  <script>
    function applyDummyPlaceholder(video) {
      if (video.getAttribute('src') !== '/images/dummy.mp4') {
        video.setAttribute('src', '/images/dummy.mp4');
      }
    }
  </script>
    
